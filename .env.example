APP_NAME="AgroLink MZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Africa/Maputo"
APP_URL=http://localhost

APP_LOCALE=pt_MZ
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de dados — PostgreSQL (secção 7 do business plan; PostGIS a activar quando
# houver build disponível para a versão do PostgreSQL instalada — ver docs/ROADMAP.md)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agrolink_mz
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secção 22 — em produção (APP_ENV=production, atrás de HTTPS) definir como true.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# Autenticação por OTP (RN01)
OTP_CODE_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Agregador de SMS local (secção 21 — canal primário)
SMS_GATEWAY_DRIVER=
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=AgroLinkMZ

# WhatsApp Business API (secção 21 — canal primário)
WHATSAPP_API_BASE_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Mobile money — via agregador (secção 17)
PAYMENTS_AGGREGATOR_DRIVER=
PAYMENTS_AGGREGATOR_BASE_URL=
PAYMENTS_AGGREGATOR_API_KEY=
PAYMENTS_AGGREGATOR_WEBHOOK_SECRET=

MPESA_SHORTCODE=
EMOLA_MERCHANT_ID=
MKESH_MERCHANT_ID=

# Comissão da plataforma (RN28 — referência 2%, configurável)
PLATFORM_COMMISSION_PERCENT=2

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@agrolinkmz.co.mz"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

VITE_APP_NAME="${APP_NAME}"
